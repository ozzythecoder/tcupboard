{
    "compilerOptions": {
        "strict": true,
        "strictNullChecks": true,
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "noImplicitAny": true,
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "./dist",
        "paths": {
            "@drizzle/*": ["./drizzle/*"],
            "@/*": ["./types/*"]
        },
        "types": ["node"]
    },
    "include": ["types", "drizzle", "scripts"]
}
