{
    "name": "@repo/tiptap",
    "version": "0.0.1",
    "private": true,
    "description": "Add TipTap as rich text editor in Directus.",
    "keywords": [
        "directus",
        "directus-extension",
        "directus-extension-bundle"
    ],
    "type": "module",
    "files": [
        "dist"
    ],
    "scripts": {
        "add": "directus-extension add",
        "build": "directus-extension build",
        "dev": "directus-extension build -w --no-minify",
        "link": "directus-extension link",
        "validate": "directus-extension validate"
    },
    "dependencies": {
        "@tiptap/extension-file-handler": "^3.27.3",
        "@tiptap/extension-image": "^3.27.3",
        "@tiptap/pm": "^3.27.3",
        "@tiptap/starter-kit": "^3.27.3",
        "@tiptap/vue-3": "^3.27.3"
    },
    "devDependencies": {
        "@directus/extensions-sdk": "18.0.1",
        "typescript": "5.9.3",
        "vue": "^3.5.24"
    },
    "icon": "extension",
    "directus:extension": {
        "type": "bundle",
        "path": {
            "app": "dist/app.js",
            "api": "dist/api.js"
        },
        "entries": [
            {
                "type": "interface",
                "name": "tcup/tiptap-interface",
                "source": "src/interface/index.ts"
            },
            {
                "type": "display",
                "name": "tiptap-display",
                "source": "src/tiptap-display/index.ts"
            }
        ],
        "host": "^12.1.1"
    }
}
