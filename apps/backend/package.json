{
  "name": "@repo/backend",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx --env-file=.env.development --watch src/server.js",
    "build": "tsc",
    "gen-types": "supabase gen types > src/types/models.ts",
    "cleanup": "biome check --write",
    "test": "echo \"No tests yet. Skipping.\"; exit 0",
    "migrate:dev": "knex migrate:latest --env development --knexfile ./migrate-config.cjs",
    "migrate:production": "knex migrate:latest --env production --knexfile ./migrate-config.cjs",
    "migrate:make": "knex migrate:make --knexfile ./migrate-config.cjs --migrations-extension cjs",
    "migrate:rollback": "knex migrate:rollback --env development --knexfile ./migrate-config.cjs"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.4",
    "@supabase/supabase-js": "^2.47.10",
    "axios": "^1.7.9",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-oauth2-jwt-bearer": "^1.6.0",
    "googleapis": "^144.0.0",
    "knex": "^3.1.0",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "supabase": "^2.76.12",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
