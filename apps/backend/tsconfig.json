{
  "compilerOptions": {
    "strict": true,
    "strictNullChecks": true,
    "verbatimModuleSyntax": true,

    "module": "NodeNext",
    "target": "ESNext",

    "outDir": "dist",
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
  },
  "include": ["src"]
}